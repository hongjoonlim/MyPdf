# Resolve paths at install time, including cmake --install --prefix overrides.
set(binary_dir "@CMAKE_INSTALL_BINDIR@")
set(data_dir "@CMAKE_INSTALL_DATADIR@")
if(NOT IS_ABSOLUTE "${binary_dir}")
  set(binary_dir "${CMAKE_INSTALL_PREFIX}/${binary_dir}")
endif()
if(NOT IS_ABSOLUTE "${data_dir}")
  set(data_dir "${CMAKE_INSTALL_PREFIX}/${data_dir}")
endif()
set(executable "${binary_dir}/MyPdf")
# Quote Exec arguments, then apply desktop-entry string escaping.
foreach(character IN ITEMS "\\" "\"" "`" "$")
  string(REPLACE "${character}" "\\${character}" executable "${executable}")
endforeach()
string(REPLACE "\\" "\\\\" executable "${executable}")
string(REPLACE "%" "%%" executable "${executable}")
set(icon "${data_dir}/pixmaps/MyPdf.png")
string(REPLACE "\\" "\\\\" icon "${icon}")
file(READ "@CMAKE_CURRENT_SOURCE_DIR@/packaging/MyPdf.desktop" entry)
string(REPLACE "Exec=MyPdf %f" "Exec=\"${executable}\" %f" entry "${entry}")
string(REPLACE "Icon=MyPdf\n" "Icon=${icon}\n" entry "${entry}")
set(output "@CMAKE_CURRENT_BINARY_DIR@/generated/installed-desktop/MyPdf.desktop")
file(WRITE "${output}" "${entry}")
file(INSTALL DESTINATION "${data_dir}/applications" TYPE FILE FILES "${output}")
find_program(MYPDF_DESKTOP_DATABASE update-desktop-database)
if(MYPDF_DESKTOP_DATABASE)
  execute_process(COMMAND "${MYPDF_DESKTOP_DATABASE}" "$ENV{DESTDIR}${data_dir}/applications"
    OUTPUT_QUIET ERROR_QUIET)
endif()
find_program(MYPDF_ICON_CACHE gtk-update-icon-cache)
if(MYPDF_ICON_CACHE)
  execute_process(COMMAND "${MYPDF_ICON_CACHE}" --force --ignore-theme-index "$ENV{DESTDIR}${data_dir}/icons/hicolor"
    OUTPUT_QUIET ERROR_QUIET)
endif()
