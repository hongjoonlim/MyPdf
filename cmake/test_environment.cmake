# GUI tests use the native macOS plugin; other platforms remain headless.
if(APPLE)
  set(_mypdf_default_qpa cocoa)
else()
  set(_mypdf_default_qpa offscreen)
endif()
set(MYPDF_TEST_QPA_PLATFORM "${_mypdf_default_qpa}" CACHE STRING "Qt platform plugin used by GUI tests")
set_property(CACHE MYPDF_TEST_QPA_PLATFORM PROPERTY STRINGS cocoa offscreen windows xcb wayland)
set(MYPDF_TEST_QT_PLUGIN_DIR "" CACHE PATH "Optional override for the matching Qt platforms plugin directory")

set(_mypdf_plugin_name "")
if(MYPDF_TEST_QPA_PLATFORM STREQUAL "cocoa")
  set(_mypdf_plugin_name QCocoaIntegrationPlugin)
elseif(MYPDF_TEST_QPA_PLATFORM STREQUAL "offscreen")
  set(_mypdf_plugin_name QOffscreenIntegrationPlugin)
elseif(MYPDF_TEST_QPA_PLATFORM STREQUAL "windows")
  set(_mypdf_plugin_name QWindowsIntegrationPlugin)
endif()
set(_mypdf_test_plugin_dir "${MYPDF_TEST_QT_PLUGIN_DIR}")
if(NOT _mypdf_test_plugin_dir AND _mypdf_plugin_name)
  # Resolve the plugin from the very same Qt installation used for linking.
  if(NOT TARGET Qt6::${_mypdf_plugin_name})
    find_package(Qt6${_mypdf_plugin_name} QUIET CONFIG PATHS "${Qt6Gui_DIR}" NO_DEFAULT_PATH)
  endif()
  if(TARGET Qt6::${_mypdf_plugin_name})
    set(_mypdf_test_plugin_dir "$<TARGET_FILE_DIR:Qt6::${_mypdf_plugin_name}>")
  endif()
endif()
set(MYPDF_GUI_TEST_ENVIRONMENT "QT_QPA_PLATFORM=${MYPDF_TEST_QPA_PLATFORM};MYPDF_QPDF=${QPDF_EXECUTABLE}")
if(_mypdf_test_plugin_dir)
  list(APPEND MYPDF_GUI_TEST_ENVIRONMENT
    "QT_QPA_PLATFORM_PLUGIN_PATH=${_mypdf_test_plugin_dir}"
    "QT_PLUGIN_PATH=${_mypdf_test_plugin_dir}/..")
else()
  message(STATUS "No explicit Qt test plugin directory found; using Qt's built-in plugin search paths")
endif()
message(STATUS "GUI test Qt platform: ${MYPDF_TEST_QPA_PLATFORM}")
